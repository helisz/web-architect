{
  "name": "web-architect",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @arch/web",
    "build": "npm run build --workspace @arch/web",
    "preview": "npm run preview --workspace @arch/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:icons": "node scripts/build-icons.mjs",
    "check:db": "node scripts/check-db.mjs"
  },
  "devDependencies": {
    "@iconify-json/devicon": "^1.2.77",
    "@iconify-json/k8s": "^1.2.2",
    "@iconify-json/tabler": "^1.2.43"
  }
}

